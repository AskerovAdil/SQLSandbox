{
  "name": "sql-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:pages": "vite build --base=/SQLSandbox/",
    "preview:pages": "vite preview --base=/SQLSandbox/ --port 4173 --strictPort",
    "test:e2e": "npm run build:pages && playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@electric-sql/pglite": "0.5.10",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-virtual": "3.14.21",
    "@xyflow/react": "12.12.0",
    "html-to-image": "1.11.13",
    "lucide-react": "1.59.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
